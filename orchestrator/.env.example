# Copy this file to .env and fill in your values

# OpenRouter API Key (required) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model slug (e.g., "qwen/qwen3.8-27b:free", "deepseek/deepseek-v4.1-flash")
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Agent URLs (defaults work for local development)
GIS_AGENT_URL=http://127.0.0.1:8000/api/gis/inference
RISK_AGENT_URL=http://127.0.0.1:8002/score

# GIS settings
GIS_BBOX_DEGREES=0.01
GIS_DEM_DIR=GIS_agent/dem_tiles

# Agent timeout
AGENT_TIMEOUT_SECONDS=20

# OpenRouter timeout
OPENROUTER_TIMEOUT_SECONDS=60

# Orchestration settings
MAX_ORCHESTRATION_ROUNDS=6
HOST=127.0.0.1
PORT=8080

# Risk service settings (if running separately)
RISK_MODEL_PATH=risk_agent/model_main (1).json
RISK_PORT=8002
RISK_HOST=127.0.0.1